{
  "version": 1,
  "bluetooth": {
    "name": "BallsPi"
  },
  "access": {
    "password": "1234"
  },
  "deviceDescription": "Runs the StuDfs HomeKit accessories: Balls, with its door and track, and PlayStream. Wi-Fi, hostname and time zone are under Device & Network; the accessories' own settings are under Application Settings.",
  "export": {
    "envFile": "/var/lib/pi-configurator/ballspi.env"
  },
  "deviceSettings": {
    "wifi": true,
    "hostname": {
      "label": "Device hostname",
      "default": "ballspi"
    },
    "timezone": {
      "default": "America/Los_Angeles"
    },
    "allowReboot": true,
    "allowAccessChanges": false
  },
  "appSettings": [
    {
      "groupName": "Balls",
      "onChange": {
        "restart": [
          "balls.service"
        ]
      },
      "items": [
        {
          "key": "BALLS_NAME",
          "label": "HomeKit name",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "default": "Ballsey"
        },
        {
          "key": "BALLS_OPEN_DOOR_LEAD_SECONDS",
          "label": "Door lead time (open)",
          "type": "number",
          "min": 0,
          "max": 60,
          "step": 0.5,
          "unit": "s",
          "default": 5
        },
        {
          "key": "BALLS_OPEN_FINISH_SECONDS",
          "label": "Open finish time",
          "type": "number",
          "min": 0,
          "max": 120,
          "step": 0.5,
          "unit": "s",
          "default": 20
        },
        {
          "key": "BALLS_CLOSE_TRACK_LEAD_SECONDS",
          "label": "Track lead time (close)",
          "type": "number",
          "min": 0,
          "max": 60,
          "step": 0.5,
          "unit": "s",
          "default": 4
        },
        {
          "key": "BALLS_CLOSE_FINISH_SECONDS",
          "label": "Close finish time",
          "type": "number",
          "min": 0,
          "max": 120,
          "step": 0.5,
          "unit": "s",
          "default": 20
        },
        {
          "key": "BALLS_HOME_ON_START",
          "label": "Home on start",
          "help": "Move the mechanism to its home position when the service starts.",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "groupName": "PlayStream",
      "onChange": {
        "restart": [
          "playstream.service"
        ]
      },
      "items": [
        {
          "key": "PLAYSTREAM_NAME",
          "label": "HomeKit name",
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "default": "PlayStream"
        },
        {
          "key": "PLAYSTREAM_STREAM_URL",
          "label": "Stream URL",
          "type": "string",
          "format": "url",
          "default": "http://streaming.live365.com/a21442"
        }
      ]
    },
    {
      "groupName": "Advanced",
      "onChange": {
        "restart": [
          "balls.service",
          "playstream.service"
        ]
      },
      "items": [
        {
          "key": "HK_LOG_LEVEL",
          "label": "Log level",
          "type": "select",
          "options": [
            {
              "value": "DEBUG",
              "label": "Debug"
            },
            {
              "value": "INFO",
              "label": "Info"
            },
            {
              "value": "WARNING",
              "label": "Warning"
            },
            {
              "value": "ERROR",
              "label": "Error"
            }
          ],
          "default": "INFO"
        }
      ]
    }
  ]
}
