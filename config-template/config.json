{
  "version": 1,
  "bluetooth": {
    "name": "SampleDevice"
  },
  "access": {
    "password": "1234"
  },
  "deviceDescription": "SampleDevice pi",
  "export": {
    "envFile": "/var/lib/pi-configurator/SampleDevice.env"
  },
  "deviceSettings": {
    "wifi": true,
    "hostname": {
      "label": "Device hostname",
      "default": "SampleDevice"
    },
    "timezone": {
      "default": "America/Los_Angeles"
    },
    "allowReboot": true,
    "allowAccessChanges": false
  },
  "appSettings": [
    {
      "groupName": "Sample Service",
      "items": [
        {
          "key": "color",
          "label": "Light color",
          "type": "select",
          "options": [
            {
              "value": "warm-white",
              "label": "Warm white"
            },
            {
              "value": "cool-white",
              "label": "Cool white"
            },
            {
              "value": "red",
              "label": "Red"
            },
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "purple",
              "label": "Purple"
            }
          ],
          "default": "warm-white",
          "help": "The color of the device's light"
        },
        {
          "key": "volume",
          "label": "Volume",
          "type": "integer",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 40,
          "help": "Speaker volume. 0 is muted"
        },
        {
          "key": "autostart",
          "label": "Start playing at boot",
          "type": "boolean",
          "default": true,
          "help": "Used when the service starts, so a change takes effect at the next boot"
        },
        {
          "key": "artistName",
          "label": "Artist name",
          "type": "string",
          "maxLength": 60,
          "default": "",
          "help": "Shown on the device's display. Leave blank to hide it"
        }
      ]
    }
  ]
}
