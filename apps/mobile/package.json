{
  "name": "@pi-configurator/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "pi-configurator phone app: finds nearby Pis over Bluetooth LE, unlocks them and edits their settings.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@pi-configurator/protocol": "workspace:*",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "3.5.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
