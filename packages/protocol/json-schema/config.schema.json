{
  "$id": "https://github.com/AlexMaghen/pi-configurator/json-schema/config.schema.json",
  "title": "pi-configurator config file",
  "description": "Shape of /etc/pi-configurator/config.json. Cross-field rules (unique keys, defaults within limits, reserved keys) are not expressible here; see packages/protocol/src/config.ts checkConfig().",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "bluetooth": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "password"
      ],
      "additionalProperties": false
    },
    "deviceDescription": {
      "type": "string",
      "maxLength": 1000
    },
    "export": {
      "type": "object",
      "properties": {
        "envFile": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^\\/.*"
        }
      },
      "required": [
        "envFile"
      ],
      "additionalProperties": false
    },
    "deviceSettings": {
      "type": "object",
      "properties": {
        "wifi": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "hostname": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "default": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "default": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "allowReboot": {
          "type": "boolean"
        },
        "allowAccessChanges": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "appSettings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "groupName": {
            "type": "string",
            "minLength": 1
          },
          "help": {
            "type": "string"
          },
          "onChange": {
            "type": "object",
            "properties": {
              "restart": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                }
              },
              "reload": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                }
              }
            },
            "additionalProperties": false
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "help": {
                      "type": "string"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "onChange": {
                      "type": "object",
                      "properties": {
                        "restart": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        },
                        "reload": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "type": {
                      "type": "string",
                      "const": "string"
                    },
                    "default": {
                      "type": "string"
                    },
                    "secret": {
                      "type": "boolean"
                    },
                    "pattern": {
                      "type": "string"
                    },
                    "format": {
                      "type": "string",
                      "enum": [
                        "url",
                        "email",
                        "multiline"
                      ]
                    },
                    "minLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxLength": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "help": {
                      "type": "string"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "onChange": {
                      "type": "object",
                      "properties": {
                        "restart": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        },
                        "reload": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "type": {
                      "type": "string",
                      "const": "integer"
                    },
                    "default": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "help": {
                      "type": "string"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "onChange": {
                      "type": "object",
                      "properties": {
                        "restart": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        },
                        "reload": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "type": {
                      "type": "string",
                      "const": "number"
                    },
                    "default": {
                      "type": "number"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "help": {
                      "type": "string"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "onChange": {
                      "type": "object",
                      "properties": {
                        "restart": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        },
                        "reload": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "type": {
                      "type": "string",
                      "const": "boolean"
                    },
                    "default": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "help": {
                      "type": "string"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "onChange": {
                      "type": "object",
                      "properties": {
                        "restart": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        },
                        "reload": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9:_.@-]+\\.(service|target|socket|timer)$"
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "type": {
                      "type": "string",
                      "const": "select"
                    },
                    "default": {
                      "type": "string"
                    },
                    "options": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "value",
                          "label"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "type",
                    "options"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "groupName",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "bluetooth",
    "access"
  ],
  "additionalProperties": false
}
